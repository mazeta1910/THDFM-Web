[Unit]
Description=Bolao THDFM FastAPI
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/thdfm
EnvironmentFile=/var/www/thdfm/.env
ExecStart=/var/www/thdfm/.venv/bin/uvicorn src.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
